# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to git.

# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found
# MongoDB Atlas (cloud, free tier):
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/campus_lost_found?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Port the Express server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Secret used to sign login tokens — use a long random string in production
# (e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
